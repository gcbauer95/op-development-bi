# Copie para .env e preencha com os dados de acesso fornecidos pela Excia.
EXCIA_BASE_URL=
EXCIA_TOKEN=
EXCIA_EMPRESA=

# PedidoLista exige uma data inicial no formato DD/MM/AAAA.
# A consulta considera pedidos emitidos a partir desta data.
EXCIA_PEDIDOS_DATA_INICIAL=

# Opcional: códigos ou descrições separados por vírgula.
# EXCIA_PEDIDOS_COLECOES=AV27,IV27

# O cliente já possui valores padrão; ajuste somente se necessário.
# EXCIA_TIMEOUT=30
# EXCIA_REQUESTS_PER_SECOND=5
# EXCIA_MAX_CONCURRENCY=5
# EXCIA_MAX_RETRIES=3
# EXCIA_BACKOFF_BASE=1
